# ==============================================================================
# MentorLink — Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root directory:
#    cp docs/env.example .env
# 2. Fill in your project credentials from your Supabase Dashboard:
#    Project Settings -> API -> Project URL & Project API Keys (anon / public).
# 3. Note: Vite client-side variables MUST begin with the 'VITE_' prefix.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Public Anonymous API Key (safe for client-side mobile app)
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# ------------------------------------------------------------------------------
# 2. Mobile Application Metadata
# ------------------------------------------------------------------------------
VITE_APP_NAME="MentorLink"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# 3. Companion APK Download Distribution (For Landing Page)
# ------------------------------------------------------------------------------
# Direct URL where the compiled MentorLink.apk is hosted for direct mobile download
VITE_APK_DOWNLOAD_URL="https://your-hosting-domain.com/downloads/MentorLink.apk"

# ==============================================================================
# CRITICAL SECURITY NOTICE:
# NEVER place the 'service_role' secret key in this file or anywhere in frontend
# code. Doing so would compromise database Row Level Security (RLS) policies and
# expose administrative privileges inside compiled APK client bundles.
# ==============================================================================
